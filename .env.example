OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=llama3.1:8b-instruct-q5_0
EMBED_MODEL=embeddinggemma:300m-qat-q8_0

CHROMA_PATH=./data/chroma
TOP_K=4
NUM_CTX=4096
NUM_PREDICT=500
OLLAMA_KEEP_ALIVE=15m
RESPONSE_CACHE_SIZE=32

DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
# Low creativity improves phrasing without turning event facts into guesses.
TEMPERATURE=0.15

# Open WebUI adapter: listen only on this Windows host. Open WebUI in Docker
# reaches it through http://host.docker.internal:8001/v1.
OT_TUTOR_ADAPTER_HOST=127.0.0.1
OT_TUTOR_ADAPTER_PORT=8001
